<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>General UMAP</title>
    <style>
      body {
        margin: 0;
        padding: 12px;
        font: 15px system-ui;
        color: #171717;
      }
      main { max-width: 1100px; margin: auto; }
      .top { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
      h1 { font-size: 18px; margin: 0; }
      select { padding: 4px; }
      svg { width: 100%; height: auto; }
      .tip {
        position: fixed;
        display: none;
        pointer-events: none;
        max-width: min(430px, calc(100vw - 24px));
        box-sizing: border-box;
        background: white;
        border: 1px solid #888;
        padding: 7px;
        line-height: 1.4;
        z-index: 10;
      }
      .legend { display: flex; gap: 8px; align-items: center; }
      .ring-key { display: inline-flex; gap: 6px; align-items: center; margin-left: 10px; }
      .ring-swatch {
        width: 12px;
        height: 12px;
        border: 2px solid #111827;
        border-radius: 50%;
        box-sizing: border-box;
      }
      .tip .mini-km { display: block; width: 400px; max-width: 100%; margin-top: 8px; }
      .tip .mini-axis text { font-size: 12px; }
      .tip .mini-axis path, .tip .mini-axis line { stroke: #888; }
      .ramp {
        width: 160px;
        height: 10px;
        background: linear-gradient(90deg, #2563eb, #22a06b, #dc4c3e);
      }
    </style>
  </head>
  <body>
    <main id="app">
      <div class="top">
        <h1></h1>
        <label>Feature family <select class="family-select"></select></label>
        <label class="property-control">Property <select class="color-select"></select></label>
        <label>Layout <select class="layout-select"></select></label>
        <span class="status">Computing UMAP…</span>
      </div>
      <svg role="img"></svg>
      <div class="legend">
        <span class="legend-title"></span>
        <span class="lo"></span>
        <span class="ramp"></span>
        <span class="hi"></span>
        <span class="ring-key" hidden>
          <span class="ring-swatch"></span>
          <span class="ring-label"></span>
        </span>
      </div>
      <div class="tip"></div>
    </main>
    <script type="module">
      import * as d3 from "https://esm.sh/d3@7.9.0";
      import { UMAP } from "https://esm.sh/umap-js@1.3.3";

      const problem = __PROBLEM__;
      const rows = __ROWS__;
      const root = document.querySelector("#app");
      const views = problem.views || [];
      const familySelect = root.querySelector(".family-select");
      const select = root.querySelector(".color-select");
      const propertyControl = root.querySelector(".property-control");
      const layoutSelect = root.querySelector(".layout-select");
      const tip = root.querySelector(".tip");

      document.title = problem.title;
      root.querySelector("h1").textContent = problem.title;
      const families = [...new Set(views.map(view => view.group || "Views"))];
      families.forEach(family => familySelect.add(new Option(family, family)));

      function positionTooltip(event) {
        const gap = 12;
        const left = event.clientX + gap + tip.offsetWidth > innerWidth - gap
          ? event.clientX - tip.offsetWidth - gap
          : event.clientX + gap;
        tip.style.left =
          `${Math.max(gap, Math.min(left, innerWidth - tip.offsetWidth - gap))}px`;
        const top = event.clientY + gap + tip.offsetHeight > innerHeight
          ? event.clientY - tip.offsetHeight - gap
          : event.clientY + gap;
        tip.style.top =
          `${Math.max(0, Math.min(top, innerHeight - tip.offsetHeight))}px`;
      }

      function populateProperties() {
        const selected = select.value;
        const familyViews = views.filter(
          view => (view.group || "Views") === familySelect.value
        );
        select.replaceChildren();
        familyViews.forEach(view => select.add(new Option(view.label, view.field)));
        propertyControl.hidden = familyViews.length <= 1;
        if ([...select.options].some(option => option.value === selected)) {
          select.value = selected;
        }
      }

      populateProperties();
      const options = problem.umap || {};
      const preprocessing = problem.preprocessing || {};
      const preservedEmbedding = rows.every(
        row => Number.isFinite(row.x) && Number.isFinite(row.y)
      ) ? rows.map(row => [row.x, row.y]) : null;
      if (preservedEmbedding) {
        layoutSelect.add(new Option("Winning Common Lisp coordinates", "preserved"));
      }
      layoutSelect.add(new Option("Recompute with umap-js", "umap-js"));
      layoutSelect.value = preservedEmbedding && options.coordinate_mode !== "umap-js"
        ? "preserved" : "umap-js";

      const means = rows[0].vector.map(
        (_, index) => d3.mean(rows, row => row.vector[index])
      );
      const deviations = rows[0].vector.map(
        (_, index) => d3.deviation(rows, row => row.vector[index]) || 1
      );
      const input = preprocessing.standardize === false
        ? rows.map(row => row.vector)
        : rows.map(row => row.vector.map(
          (value, index) => (value - means[index]) / deviations[index]
        ));
      function browserEmbedding() {
        let seed = options.seed || 123456789;
        const random = () => {
          seed |= 0;
          seed = seed + 0x6D2B79F5 | 0;
          let value = Math.imul(seed ^ seed >>> 15, 1 | seed);
          value = value + Math.imul(value ^ value >>> 7, 61 | value) ^ value;
          return ((value ^ value >>> 14) >>> 0) / 4294967296;
        };
        return new UMAP({
          nComponents: 2,
          nNeighbors: options.neighbors || 15,
          minDist: options.minimum_distance ?? 0.1,
          nEpochs: options.epochs || 300,
          random
        }).fit(input);
      }

      function applyLayout() {
        const embedding = layoutSelect.value === "preserved"
          ? preservedEmbedding : browserEmbedding();
        rows.forEach((row, index) => [row.x, row.y] = embedding[index]);
        root.querySelector(".status").textContent =
          `${rows.length.toLocaleString()} observations · ${
            layoutSelect.value === "preserved"
              ? "Common Lisp winner" : "umap-js recomputation"
          }`;
        draw();
      }

      const svg = d3.select("svg");
      const series = [...d3.schemeTableau10, ...d3.schemeSet3];

      function fieldValue(row, field) {
        return row[field];
      }

      function formatValue(value, declaration = {}) {
        return declaration.format === "usd-k" && typeof value === "number"
          ? `${Math.round(value / 1000).toLocaleString()}k`
          : declaration.format === "percent" && typeof value === "number"
          ? `${value.toFixed(1)}%`
          : declaration.format === "years" && typeof value === "number"
          ? `${Number.isInteger(value) ? value : value.toFixed(1)} ${value === 1 ? "year" : "years"}`
          : typeof value === "number"
          ? value.toFixed(3)
          : String(value ?? "unavailable");
      }

      function renderTooltipPlot(row) {
        const spec = problem.tooltip_plot;
        if (!spec || spec.kind !== "kaplan-meier") return;
        const points = row[spec.field];
        if (!Array.isArray(points) || points.length < 2) return;
        const width = 400, height = 180;
        const margin = { top: 10, right: 12, bottom: 36, left: 48 };
        const chart = d3.select(tip).append("svg")
          .attr("class", "mini-km")
          .attr("viewBox", `0 0 ${width} ${height}`)
          .attr("role", "img")
          .attr("aria-label", "Kaplan-Meier evidence curve");
        const x = d3.scaleLinear().domain([0, d3.max(points, p => p[0])])
          .range([margin.left, width - margin.right]);
        const y = d3.scaleLinear().domain([0, 1])
          .range([height - margin.bottom, margin.top]);
        chart.append("g").attr("class", "mini-axis")
          .attr("transform", `translate(0,${height - margin.bottom})`)
          .call(d3.axisBottom(x).ticks(5));
        chart.append("g").attr("class", "mini-axis")
          .attr("transform", `translate(${margin.left},0)`)
          .call(d3.axisLeft(y).ticks(4).tickFormat(d3.format(".0%")));
        chart.append("path").datum(points).attr("fill", "none")
          .attr("stroke", "#2563eb").attr("stroke-width", 2.5)
          .attr("d", d3.line().curve(d3.curveStepAfter)
            .x(p => x(p[0])).y(p => y(p[1])));
        chart.append("text").attr("x", width / 2).attr("y", height - 4)
          .attr("text-anchor", "middle").text(spec.x_label || "Time");
        chart.append("text").attr("transform", `translate(13,${height / 2}) rotate(-90)`)
          .attr("text-anchor", "middle").text(spec.y_label || "Survival");
      }

      function draw() {
        const view = views.find(item => item.field === select.value) || views[0];
        const width = Math.max(400, root.clientWidth);
        const height = Math.max(420, Math.min(650, width * 0.62));
        const margin = { top: 15, right: 20, bottom: 45, left: 60 };

        svg.attr("viewBox", `0 0 ${width} ${height}`)
          .selectAll("*")
          .remove();

        const x = d3.scaleLinear()
          .domain(d3.extent(rows, row => row.x))
          .nice()
          .range([margin.left, width - margin.right]);
        const y = d3.scaleLinear()
          .domain(d3.extent(rows, row => row.y))
          .nice()
          .range([height - margin.bottom, margin.top]);
        const values = rows.map(row => fieldValue(row, view.field));
        const categorical = view.type === "categorical";
        const domain = categorical
          ? [...new Set(values)]
          : d3.extent(values);
        const color = categorical
          ? d3.scaleOrdinal(domain, series)
          : options.continuous_color_scale === "quantile-turbo"
            ? d3.scaleSequentialQuantile(values, d3.interpolateTurbo)
            : d3.scaleSequential(domain, d3.interpolateViridis);

        // Interpolate a continuous feature field over the full plotting plane.
        // Quantile thresholds keep outliers from collapsing most colors into
        // the center of the palette; translucent filled contours make regions
        // readable while preserving the individual observations above them.
        if (options.feature_contours && !categorical) {
          const gridWidth = 112;
          const gridHeight = Math.max(56, Math.round(
            gridWidth * (height - margin.top - margin.bottom)
              / (width - margin.left - margin.right)
          ));
          const projected = rows.map(row => ({
            px: (x(row.x) - margin.left)
              / (width - margin.left - margin.right) * (gridWidth - 1),
            py: (y(row.y) - margin.top)
              / (height - margin.top - margin.bottom) * (gridHeight - 1),
            value: Number(fieldValue(row, view.field))
          }));
          const grid = new Float64Array(gridWidth * gridHeight);
          for (let gy = 0; gy < gridHeight; gy += 1) {
            for (let gx = 0; gx < gridWidth; gx += 1) {
              const nearest = projected
                .map(point => ({
                  ...point,
                  distance2: (gx - point.px) ** 2 + (gy - point.py) ** 2
                }))
                .sort((left, right) => left.distance2 - right.distance2)
                .slice(0, 8);
              const exact = nearest.find(point => point.distance2 < 1e-9);
              grid[gy * gridWidth + gx] = exact
                ? exact.value
                : d3.sum(nearest, point => point.value / point.distance2)
                  / d3.sum(nearest, point => 1 / point.distance2);
            }
          }
          const levelCount = options.feature_contour_levels || 12;
          const sortedValues = values.map(Number).sort(d3.ascending);
          const thresholds = d3.range(1, levelCount).map(
            index => d3.quantileSorted(sortedValues, index / levelCount)
          );
          const contours = d3.contours()
            .size([gridWidth, gridHeight])
            .thresholds(thresholds)(grid);
          const contourLayer = svg.append("g")
            .attr("transform", `translate(${margin.left},${margin.top}) scale(${
              (width - margin.left - margin.right) / gridWidth
            },${(height - margin.top - margin.bottom) / gridHeight})`);
          contourLayer.selectAll("path.feature-contour")
            .data(contours).join("path")
            .attr("class", "feature-contour")
            .attr("d", d3.geoPath())
            .attr("fill", contour => color(contour.value))
            .attr("fill-opacity", options.feature_contour_opacity ?? 0.38)
            .attr("stroke", contour => options.feature_contour_lines
              ? d3.color(color(contour.value)).darker(0.9) : "none")
            .attr("stroke-width", options.feature_contour_lines
              ? (options.feature_contour_line_width ?? 0.5) : 0)
            .attr("vector-effect", "non-scaling-stroke");
        }

        if (options.density_surface && (categorical || !options.feature_contours)) {
          svg.append("defs")
            .append("clipPath")
            .attr("id", "density-clip")
            .append("rect")
            .attr("x", margin.left)
            .attr("y", margin.top)
            .attr("width", width - margin.left - margin.right)
            .attr("height", height - margin.top - margin.bottom);
          const estimator = d3.contourDensity()
            .x(row => x(row.x))
            .y(row => y(row.y))
            .size([width, height])
            .bandwidth(options.density_bandwidth || 24)
            .thresholds(options.density_thresholds || 12);
          let densityGroups;
          if (options.density_color === "data" && categorical) {
            densityGroups = domain.map(value => ({
              value,
              rows: rows.filter(row => fieldValue(row, view.field) === value)
            }));
          } else if (options.density_color === "data") {
            const count = options.density_color_bands || 7;
            const span = domain[1] - domain[0] || 1;
            densityGroups = Array.from({ length: count }, (_, index) => ({
              value: domain[0] + span * (index + 0.5) / count,
              rows: []
            }));
            rows.forEach(row => {
              const value = fieldValue(row, view.field);
              const index = Math.min(
                count - 1,
                Math.max(0, Math.floor(count * (value - domain[0]) / span))
              );
              densityGroups[index].rows.push(row);
            });
            densityGroups = densityGroups.filter(group => group.rows.length);
          } else {
            densityGroups = [{ value: null, rows }];
          }
          const layers = densityGroups.flatMap(group =>
            estimator(group.rows).map(contour => ({
              contour,
              fill: options.density_color === "data"
                ? color(group.value)
                : options.density_color || "#64748b"
            }))
          );
          const maximumDensity = d3.max(
            layers,
            layer => layer.contour.value
          );
          svg.append("g")
            .attr("clip-path", "url(#density-clip)")
            .selectAll("path")
            .data(layers)
            .join("path")
            .attr("d", layer => d3.geoPath()(layer.contour))
            .attr("fill", layer => layer.fill)
            .attr("opacity", layer =>
              (options.density_opacity || 0.08)
              * layer.contour.value / maximumDensity
            );
        }

        svg.append("g")
          .attr("transform", `translate(0,${height - margin.bottom})`)
          .call(d3.axisBottom(x));
        svg.append("g")
          .attr("transform", `translate(${margin.left},0)`)
          .call(d3.axisLeft(y));
        svg.append("g")
          .selectAll(".point-halo")
          .data(rows)
          .join("circle")
          .attr("class", "point-halo")
          .attr("cx", row => x(row.x))
          .attr("cy", row => y(row.y))
          .attr("r", options.point_radius || 4)
          .attr("fill", row => color(fieldValue(row, view.field)))
          .attr("opacity", options.point_opacity ?? 0.78)
          .on("pointerenter", (event, row) => {
            tip.style.display = "block";
            const declared = problem.tooltip || [];
            const selectedDeclared = declared.some(field => field.field === view.field);
            const propertyFields = selectedDeclared
              ? declared
              : [{ field: view.field, label: view.label }, ...declared];
            const propertyText = propertyFields
              .filter(field => {
                const raw = fieldValue(row, field.field);
                return !(field.omit_prefix
                  && String(raw ?? "").startsWith(field.omit_prefix));
              })
              .map(field => {
                const value = formatValue(fieldValue(row, field.field), field);
                return `${field.label}: ${value}`;
              })
              .join("<br>");
            tip.innerHTML = propertyText;
            renderTooltipPlot(row);
            positionTooltip(event);
          })
          .on("pointermove", positionTooltip)
          .on("pointerleave", () => tip.style.display = "none");

        if (options.highlight_ring_field) {
          const ringThreshold = options.highlight_ring_threshold ?? 50;
          const ringRows = rows.filter(row =>
            Number(fieldValue(row, options.highlight_ring_field)) > ringThreshold
          );
          svg.append("g")
            .selectAll(".highlight-ring")
            .data(ringRows)
            .join("circle")
            .attr("class", "highlight-ring")
            .attr("cx", row => x(row.x))
            .attr("cy", row => y(row.y))
            .attr("r", options.highlight_ring_radius
              || ((options.point_radius || 4) + 3))
            .attr("fill", "none")
            .attr("stroke", options.highlight_ring_color || "#111827")
            .attr("stroke-width", options.highlight_ring_width || 1.5)
            .attr("stroke-opacity", options.highlight_ring_opacity ?? 0.9)
            .attr("pointer-events", "none");
        }

        if ((options.center_point_radius || 0) > 0) {
          const centerEvery = Math.max(1, options.center_point_every || 1);
          const centerRows = rows.filter(
            (_, index) => index % centerEvery === 0
          );
          const centerColor = row => {
            const original = color(fieldValue(row, view.field));
            if (options.center_point_color !== "complement") {
              return options.center_point_color || original;
            }
            const rgb = d3.rgb(original);
            return d3.rgb(255 - rgb.r, 255 - rgb.g, 255 - rgb.b).formatHex();
          };
          svg.append("g")
            .selectAll(".point-center")
            .data(centerRows)
            .join("circle")
            .attr("class", "point-center")
            .attr("cx", row => x(row.x))
            .attr("cy", row => y(row.y))
            .attr("r", options.center_point_radius)
            .attr("fill", centerColor)
            .attr("opacity", options.center_point_opacity ?? 1)
            .attr("pointer-events", "none");
        }

        root.querySelector(".legend-title").textContent =
          categorical ? "Categories" : view.label;
        root.querySelector(".ramp").style.background = categorical
          ? "linear-gradient(90deg, #4e79a7, #f28e2b, #e15759)"
          : options.continuous_color_scale === "quantile-turbo"
            ? `linear-gradient(90deg, ${d3.range(0, 1.001, 0.1)
                .map(value => d3.interpolateTurbo(value)).join(",")})`
            : "linear-gradient(90deg, #440154, #21918c, #fde725)";
        root.querySelector(".lo").textContent = categorical
          ? domain[0]
          : formatValue(domain[0], view);
        root.querySelector(".hi").textContent = categorical
          ? domain.at(-1)
          : formatValue(domain[1], view);
        root.querySelector(".legend").style.display = view ? "flex" : "none";
        const ringKey = root.querySelector(".ring-key");
        ringKey.hidden = !options.highlight_ring_field;
        if (options.highlight_ring_field) {
          root.querySelector(".ring-swatch").style.borderColor =
            options.highlight_ring_color || "#111827";
          root.querySelector(".ring-label").textContent =
            options.highlight_ring_label ||
            `Above ${options.highlight_ring_threshold ?? 50}`;
        }
      }

      select.addEventListener("change", draw);
      familySelect.addEventListener("change", () => {
        populateProperties();
        draw();
      });
      layoutSelect.addEventListener("change", applyLayout);
      new ResizeObserver(draw).observe(root);
      applyLayout();
    </script>
  </body>
</html>
