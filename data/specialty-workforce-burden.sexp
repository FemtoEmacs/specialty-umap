(:FORMAT :SPECIALTY-WORKFORCE-BURDEN :VERSION 1 :COUNTRY :UNITED-STATES :AS-OF "2026-09-05" :FEATURE
 (:ID :PHYSICIANS-PER-1000-RELEVANT-PATIENTS :TYPE :CONTINUOUS :DIRECTION
  :HIGHER-MEANS-MORE-PHYSICIAN-SUPPLY-RELATIVE-TO-BURDEN :FORMULA "physician-count / (relevant-patient-count / 1000)"
  :RECOMMENDED-TRANSFORM :LOG10-THEN-Z-SCORE :UMAP-USE-ALL-RECORDS T)
 :INTERPRETATION
 (:PREFERRED-LABEL "workforce-to-burden density" :NOT-EQUIVALENT-TO
  "formal shortage, adequacy, access, wait time, geographic distribution, or demand")
