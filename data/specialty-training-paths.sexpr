   (:id :pain-medicine :years 5 :reason "Completed four-year qualifying residency plus one-year fellowship")
   (:id :clinical-informatics :years 5 :reason "Completed three-year primary residency plus two-year fellowship")
   (:id :medical-oncology :years 6 :reason "Representative U.S. oncology pathway is three years internal medicine plus three years combined hematology/medical oncology")
   (:id :neurocritical-care :years 6 :reason "Completed four-year neurology pathway plus two-year fellowship")
   (:id :neuromuscular-medicine :years 5 :reason "Completed four-year neurology or PM&R pathway plus one-year fellowship")
