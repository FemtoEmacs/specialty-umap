 :feature
 (:id :minimum-total-gme-years
  :label "Minimum accredited residency/fellowship years after medical school"
  :type :continuous
  :derivation "Shortest standard qualifying path represented by each record; excludes medical school and optional non-accredited advanced fellowships.")
 :sources
 ((:id :acgme-data-resource-book-2024-2025
   :publisher "Accreditation Council for Graduate Medical Education"
   :title "Data Resource Book, Academic Year 2024-2025"
   :table "A.11"
   :url "https://www.acgme.org/globalassets/pfassets/publicationsbooks/2024-2025_acgme_databook_document.pdf"
   :retrieved "2026-09-05"
   :use "Prior accredited training and accredited program lengths")
  (:id :abms-certificates
   :publisher "American Board of Medical Specialties"
   :title "Specialty and Subspecialty Certificates"
   :url "https://www.abms.org/member-boards/specialty-subspecialty-certificates/"
   :retrieved "2026-09-05"
   :use "Cross-check of board-recognized specialty and subspecialty names"))
 :notes
 ("Program categories, certification certificates, and everyday practice names are not perfectly identical."
  "ACGME Table A.11 reports exceptions and alternative program structures; alternatives are retained in :prior-years and :program-years."
 "The scalar feature is a minimum standard path, not a promise that every physician completes exactly that duration."
  "Cardiology is stored as an alias of the ACGME category cardiovascular disease."
  "Interventional cardiology is normally one year after three years of cardiovascular disease, not two years.")
 :representative-duration
 (:id :representative-total-gme-years
  :label "Representative completed residency/fellowship years after medical school"
  :derivation "Uses the ordinary completed clinical pathway for a practicing specialist rather than an exceptional early-entry or minimum-accreditation route. Medical oncology uses the overwhelmingly prevalent combined hematology/medical-oncology pathway (195 programs versus one medical-oncology-only program in ACGME Table A.11)."
  :overrides
